{
  "openapi": "3.1.0",
  "info": {
    "title": "Raw and framed media",
    "version": "1"
  },
  "servers": [
    {
      "url": "https://example.test"
    }
  ],
  "components": {
    "schemas": {
      "Binary": {
        "type": "string",
        "format": "binary"
      },
      "Config": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/binary": {
      "post": {
        "operationId": "uploadBinary",
        "requestBody": {
          "required": false,
          "content": {
            "application/octet-stream": {
              "schema": {
                "$ref": "#/components/schemas/Binary"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "accepted"
          }
        }
      }
    },
    "/markdown": {
      "post": {
        "operationId": "sendMarkdown",
        "requestBody": {
          "required": false,
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              }
            },
            "text/x-markdown": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "accepted"
          }
        }
      }
    },
    "/records": {
      "post": {
        "operationId": "uploadRecords",
        "requestBody": {
          "required": true,
          "content": {
            "application/jsonl": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "accepted"
          }
        }
      }
    },
    "/ndjson": {
      "post": {
        "operationId": "uploadNdjson",
        "requestBody": {
          "required": false,
          "content": {
            "application/x-ndjson": {
              "schema": {
                "$ref": "#/components/schemas/Binary"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "accepted"
          }
        }
      }
    },
    "/scripts": {
      "post": {
        "operationId": "sendScript",
        "requestBody": {
          "required": false,
          "content": {
            "application/javascript": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "text/javascript": {
              "schema": {
                "type": "string"
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "script": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "accepted"
          }
        }
      }
    },
    "/config": {
      "post": {
        "operationId": "sendConfig",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Config"
              }
            },
            "text/plain;charset=UTF-8": {
              "schema": {
                "$ref": "#/components/schemas/Config"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "accepted"
          }
        }
      }
    },
    "/mixed": {
      "post": {
        "operationId": "sendMixed",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "application/octet-stream": {
              "schema": {
                "$ref": "#/components/schemas/Binary"
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            },
            "application/x-forbidden+json": {
              "schema": false
            }
          }
        },
        "responses": {
          "204": {
            "description": "accepted"
          }
        }
      }
    },
    "/json-binary": {
      "post": {
        "operationId": "sendJsonBinary",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "accepted"
          }
        }
      }
    },
    "/charset": {
      "post": {
        "operationId": "sendCharset",
        "requestBody": {
          "required": false,
          "content": {
            "text/plain; charset=UTF-8": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "accepted"
          }
        }
      }
    },
    "/patch": {
      "post": {
        "operationId": "sendPatch",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": true
            },
            "application/merge-patch+json": {
              "schema": true
            }
          }
        },
        "responses": {
          "204": {
            "description": "accepted"
          }
        }
      }
    }
  }
}
