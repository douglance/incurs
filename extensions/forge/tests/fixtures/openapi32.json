{
  "openapi": "3.2.0",
  "info": {
    "title": "OpenAPI 3.2 execution proof",
    "version": "1"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/find": {
      "query": {
        "operationId": "findItems",
        "parameters": [
          {
            "name": "filter",
            "in": "querystring",
            "required": true,
            "content": {
              "application/x-www-form-urlencoded": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "term": {
                      "type": "string"
                    },
                    "labels": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "encoding": {
                  "labels": {
                    "style": "form",
                    "explode": true
                  }
                }
              }
            }
          },
          {
            "name": "prefs",
            "in": "cookie",
            "style": "cookie",
            "schema": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string"
                },
                "token": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Found"
          }
        }
      }
    },
    "/copy/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "additionalOperations": {
        "x-Copy": {
          "operationId": "copyItem",
          "parameters": [
            {
              "name": "X-Meta",
              "in": "header",
              "required": true,
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          ],
          "responses": {
            "204": {
              "description": "Copied"
            }
          }
        }
      }
    },
    "/raw": {
      "get": {
        "operationId": "readRaw",
        "parameters": [
          {
            "name": "raw",
            "in": "querystring",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Read"
          }
        }
      }
    },
    "/content": {
      "get": {
        "operationId": "readContent",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Read"
          }
        }
      }
    }
  }
}
