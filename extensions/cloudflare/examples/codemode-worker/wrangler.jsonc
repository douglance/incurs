{
  "name": "incurs-codemode-example",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "CODEMODE", "class_name": "CodeModeExample" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CodeModeExample"] }
  ],
  "worker_loaders": [
    { "binding": "LOADER" }
  ],
  "build": {
    "command": "worker-build --release"
  }
}
